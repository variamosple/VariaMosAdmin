{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "extends": ["./biome.shared.jsonc"],
  "plugins": [
    "./rules/no-unknown.grit",
    "./rules/no-trivial-assertion.grit",
    "./rules/called-without-arguments.grit"
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!dist",
      "!build",
      "!coverage",
      "!.stryker-tmp",
      "!strykerTmp",
      "!node_modules"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": {
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error", "warn"]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "overrides": [
    {
      "includes": [
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/setupTests.ts",
        "src/shared/tests/**"
      ],
      "javascript": {
        "globals": ["vi"]
      }
    },
    {
      "includes": ["src/shared/components/About/index.tsx"],
      "linter": {
        "rules": {
          "nursery": {
            "noUnsafeIframeSandbox": "off"
          }
        }
      }
    }
  ]
}
