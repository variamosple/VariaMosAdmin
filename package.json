{
  "name": "variamos_admin",
  "version": "0.1.0",
  "private": true,
  "homepage": "variamos_admin/",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "patch-package",
    "prepare": "husky",
    "check-arch": "dependency-cruiser --config .dependency-cruiser.js src/",
    "lint": "biome check src/",
    "lint:errors": "biome check --diagnostic-level=error src/",
    "lint:fix": "biome check --write --unsafe src/",
    "typecheck": "tsc --noEmit",
    "find-deadcode": "knip",
    "check-updates": "taze",
    "cypress:run:mocked": "bash ./scripts/run-mocked-docker.sh",
    "docker:test:up": "VARIAMOS_WORKSPACE_DIR=${VARIAMOS_WORKSPACE_DIR:-} docker compose -f docker-compose.test.yml up -d",
    "docker:test:down": "VARIAMOS_WORKSPACE_DIR=${VARIAMOS_WORKSPACE_DIR:-} docker compose -f docker-compose.test.yml down && docker image prune -f",
    "cypress:run:real": "npm run docker:test:up && start-server-and-test start http://localhost:3000 \"cypress run --spec 'cypress/integration/**/*.real.spec.js'\" ; status=$?; npm run docker:test:down; exit $status"
  },
  "dependencies": {
    "@patternfly/react-core": "^6.6.1",
    "@patternfly/react-log-viewer": "^6.5.0",
    "@variamosple/variamos-components": "^0.0.24",
    "axios": "^1.19.0",
    "bootstrap": "^5.3.8",
    "react": "^19.2.8",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-router-dom": "^7.18.2",
    "react-svg-worldmap": "^2.0.2",
    "recharts": "^3.10.1",
    "web-vitals": "^6.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "cspell": "^10.0.1",
    "cypress": "^15.20.1",
    "dependency-cruiser": "^18.2.0",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.32.1",
    "lint-staged": "^17.3.0",
    "msw": "^2.15.0",
    "patch-package": "^8.0.1",
    "pg": "^8.23.0",
    "start-server-and-test": "^3.0.12",
    "taze": "^20.0.1",
    "typescript": "^7.0.2",
    "undici": "^8.10.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "nth-check": "^3.0.1",
    "postcss": "^8.5.26",
    "react": "$react",
    "react-dom": "$react-dom",
    "serialize-javascript": "^7.1.0",
    "svgo": "^4.0.2",
    "underscore": "^1.13.8",
    "sockjs": {
      "uuid": "^14.0.1"
    }
  },
  "allowScripts": {
    "core-js@3.40.0": true,
    "core-js-pure@3.40.0": true,
    "msw@2.15.0": true,
    "@biomejs/biome@2.5.7": true,
    "cypress@15.20.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true
  }
}
