{
  "name": "variamos_admin",
  "version": "0.1.0",
  "private": true,
  "homepage": "variamos_admin/",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "vite",
    "preview": "vite preview",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "stryker": "stryker run",
    "prepare": "husky",
    "check-arch": "dependency-cruiser --config .dependency-cruiser.js src/",
    "lint": "biome check src/",
    "lint:errors": "biome check --diagnostic-level=error src/",
    "lint:fix": "biome check --write --unsafe src/",
    "typecheck": "tsc --noEmit",
    "find-deadcode": "knip",
    "check-updates": "taze",
    "playwright:run:mocked": "bash ./scripts/run-mocked-playwright.sh",
    "docker:test:up": "VARIAMOS_WORKSPACE_DIR=${VARIAMOS_WORKSPACE_DIR:-} docker compose -f docker-compose.test.yml up -d --build",
    "docker:test:down": "VARIAMOS_WORKSPACE_DIR=${VARIAMOS_WORKSPACE_DIR:-} docker compose -f docker-compose.test.yml down && docker image prune -f",
    "playwright:run:real": "npm run build && npm run docker:test:up && start-server-and-test \"npx vite preview --port 3000\" http://localhost:3000 \"bash ./scripts/playwright-test.sh --grep .real.\" ; status=$?; npm run docker:test:down; exit $status",
    "microservices:docker:up": "VARIAMOS_WORKSPACE_DIR=${VARIAMOS_WORKSPACE_DIR:-} docker compose -f docker-compose.test.yml up -d --build",
    "microservices:docker:down": "docker compose -f docker-compose.test.yml down",
    "microservices:docker:logs": "docker compose -f docker-compose.test.yml logs -f"
  },
  "dependencies": {
    "@patternfly/react-core": "^6.6.1",
    "@patternfly/react-log-viewer": "^6.5.0",
    "@variamosple/variamos-components": "^0.2.3",
    "axios": "^1.19.0",
    "bootstrap": "^5.3.8",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "react-svg-worldmap": "^2.2.0",
    "recharts": "^3.10.1",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.64.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "cspell": "^10.3.6",
    "dependency-cruiser": "^18.6.0",
    "dotenv": "^18.0.7",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "msw": "^2.15.0",
    "pg": "^8.23.1",
    "start-server-and-test": "^3.0.13",
    "taze": "^21.3.0",
    "typescript": "^6.0.3",
    "undici": "^8.12.1",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "nth-check": "^3.0.1",
    "postcss": "^8.5.26",
    "react": "$react",
    "react-dom": "$react-dom",
    "serialize-javascript": "^7.1.0",
    "svgo": "^4.0.2",
    "underscore": "^1.13.8",
    "sockjs": {
      "uuid": "^14.0.1"
    }
  },
  "allowScripts": {
    "core-js@3.40.0": true,
    "core-js-pure@3.40.0": true,
    "msw@2.15.0": true,
    "@biomejs/biome@2.5.7": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true
  }
}
