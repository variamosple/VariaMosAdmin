{
  "name": "variamos_admin",
  "version": "0.1.0",
  "private": true,
  "homepage": "variamos_admin/",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "start": "vite",
    "preview": "vite preview",
    "build": "tsc --incremental --tsBuildInfoFile node_modules/.cache/tsc/app.tsbuildinfo && vite build",
    "test": "vitest run",
    "kit": "bash scripts/kit.sh start",
    "kit:stop": "bash scripts/kit.sh stop",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "stryker": "stryker run",
    "prepare": "husky",
    "check-arch": "dependency-cruiser --config .dependency-cruiser.js src/",
    "lint": "biome check --error-on-warnings . && node scripts/check-suppressions.mjs",
    "lint:errors": "biome check --diagnostic-level=error .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/app.tsbuildinfo && tsc --noEmit -p tsconfig.e2e.json --incremental --tsBuildInfoFile node_modules/.cache/tsc/e2e.tsbuildinfo",
    "find-deadcode": "knip",
    "spell": "cspell --no-progress --dot --gitignore \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json,jsonc,css,md,yml,yaml,sh}\" \"**/Dockerfile*\"",
    "check-updates": "taze",
    "playwright:run:mocked": "bash ./scripts/run-mocked-playwright.sh",
    "docker:test:up": "VARIAMOS_WORKSPACE_DIR=${VARIAMOS_WORKSPACE_DIR:-} COMPOSE_FILE=${COMPOSE_FILE:-docker-compose.test.yml} docker compose up -d --build",
    "docker:test:down": "VARIAMOS_WORKSPACE_DIR=${VARIAMOS_WORKSPACE_DIR:-} COMPOSE_FILE=${COMPOSE_FILE:-docker-compose.test.yml} docker compose down && docker image prune -f",
    "playwright:run:real": "npm run build && npm run docker:test:up && start-server-and-test \"npx vite preview --port 3000\" http://localhost:3000 \"bash ./scripts/playwright-test.sh --grep .real.\" ; status=$?; npm run docker:test:down; exit $status",
    "microservices:docker:up": "VARIAMOS_WORKSPACE_DIR=${VARIAMOS_WORKSPACE_DIR:-} docker compose -f docker-compose.test.yml up -d --build",
    "microservices:docker:down": "docker compose -f docker-compose.test.yml down",
    "microservices:docker:logs": "docker compose -f docker-compose.test.yml logs -f"
  },
  "dependencies": {
    "@fontsource/play": "^5.3.0",
    "@patternfly/react-core": "^6.7.0",
    "@patternfly/react-log-viewer": "^6.5.0",
    "@variamosple/variamos-components": "^0.14.0",
    "axios": "^1.21.1",
    "bootstrap": "^5.3.9",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^7.18.6",
    "react-svg-worldmap": "^2.7.0",
    "recharts": "^3.11.1",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@biomejs/biome": "^2.6.9",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "cspell": "^10.5.2",
    "dependency-cruiser": "^18.9.0",
    "dotenv": "^18.0.10",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "knip": "^6.48.0",
    "lint-staged": "^17.6.2",
    "msw": "^2.15.0",
    "pg": "^8.23.1",
    "start-server-and-test": "^3.0.13",
    "taze": "^21.3.0",
    "typescript": "^6.0.3",
    "undici": "^8.13.1",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "nth-check": "^3.0.1",
    "postcss": "^8.5.26",
    "react": "$react",
    "react-dom": "$react-dom",
    "serialize-javascript": "^7.1.0",
    "svgo": "^4.0.2",
    "underscore": "^1.13.8",
    "sockjs": {
      "uuid": "^14.0.1"
    },
    "@stryker-mutator/core": {
      "minimatch": "^11.0.1"
    }
  },
  "allowScripts": {
    "core-js@3.40.0": true,
    "core-js-pure@3.40.0": true,
    "msw@2.15.0": true,
    "@biomejs/biome@2.5.7": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true
  }
}
