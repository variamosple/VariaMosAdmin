{
  "$schema": "https://schema.stryker-mutator.io/stryker-config.json",
  "mutate": [
    "src/features/**/domain/**/*.ts",
    "src/shared/domain/**/*.ts",
    "src/shared/hooks/**/*.ts",
    "!src/**/*.test.{ts,tsx}",
    "!src/**/*.spec.{ts,tsx}",
    "!src/**/*.d.ts"
  ],
  "testRunner": "vitest",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "vitest": {
    "configFile": "vitest.config.mts"
  },
  "reporters": ["progress", "clear-text", "html"],
  "concurrency": 2,
  "incremental": true,
  "ignoreStatic": true,
  "coverageAnalysis": "perTest",
  "thresholds": {
    "break": 50
  }
}
